{
  "version": 2,
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } },
    { "src": "server/api/[...all].js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/api/(.*)$", "dest": "/server/api/[...all].js" },
    { "src": "^/api$", "dest": "/server/api/[...all].js" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/frontend/dist/index.html" }
  ]
}
