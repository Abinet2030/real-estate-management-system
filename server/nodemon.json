{
  "watch": [
    "*.js",
    "routes/**/*.js",
    "controllers/**/*.js",
    "middleware/**/*.js",
    "models/**/*.js",
    "lib/**/*.js"
  ],
  "ext": "js,json,env",
  "ignore": [
    "../frontend/**",
    "uploads/**",
    "node_modules/**"
  ],
  "env": {
    "USE_IN_MEMORY_DB": "true",
    "PORT": "4000",
    "NODE_ENV": "development"
  }
}
